/* F1 HUB v2 — design tokens & components */
:root{
  --bg:#15151E;
  --surface:#1c1c28;
  --surface-2:#262633;
  --surface-3:#2f2f3e;
  --line:rgba(255,255,255,.06);
  --line-strong:rgba(255,255,255,.12);
  --text:#fafafa;
  --muted:#a0a0b0;
  --muted-2:#6b6b7b;
  --red:#E10600;
  --red-hover:#FF1A0D;
  --gold:#FFCB05;
  --silver:#C0C0C0;
  --bronze:#CD7F32;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;color:var(--text);
  font-family:'Manrope',ui-sans-serif,system-ui,sans-serif;
  font-weight:400;-webkit-font-smoothing:antialiased;letter-spacing:-.005em}
body{overflow-x:hidden;
  background:
    radial-gradient(ellipse 1200px 800px at 20% 0%, rgba(225,6,0,.06) 0%, transparent 50%),
    radial-gradient(ellipse 1000px 600px at 100% 50%, rgba(80,80,200,.04) 0%, transparent 50%),
    radial-gradient(ellipse 800px 600px at 0% 100%, rgba(225,6,0,.04) 0%, transparent 50%),
    var(--bg);
  background-attachment:fixed}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:0;background:none;color:inherit}
input,textarea,select{font-family:inherit}

.cnt{max-width:1280px;margin:0 auto;padding:0 24px}
@media(max-width:720px){.cnt{padding:0 16px}}

.h-display{font-weight:800;letter-spacing:-.025em;line-height:1.02}
.h-section{font-weight:800;font-size:14px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
.eyebrow{font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
.eyebrow-red{color:var(--red)}
.mono{font-variant-numeric:tabular-nums;font-feature-settings:'tnum'}

/* Buttons */
.btn{display:inline-flex;align-items:center;gap:8px;padding:11px 22px;font-weight:700;font-size:13px;
  border-radius:999px;transition:all .18s ease;letter-spacing:-.005em}
.btn-red{background:var(--red);color:#fff}
.btn-red:hover{background:var(--red-hover);transform:translateY(-1px)}
.btn-ghost{background:rgba(255,255,255,.06);color:var(--text);border:1px solid var(--line-strong)}
.btn-ghost:hover{background:rgba(255,255,255,.1)}
.btn-link{padding:6px 0;font-size:13px;font-weight:700;color:var(--text);display:inline-flex;gap:8px;align-items:center}
.btn-link::after{content:'→';transition:transform .18s}
.btn-link:hover::after{transform:translateX(3px)}
.btn-sm{padding:8px 14px;font-size:12px}

/* Top nav */
.topnav{position:sticky;top:0;z-index:50;background:rgba(21,21,30,.85);backdrop-filter:blur(20px) saturate(140%);
  -webkit-backdrop-filter:blur(20px) saturate(140%);border-bottom:1px solid var(--line);padding:14px 0}
.topnav .row{display:flex;align-items:center;gap:32px}
.topnav .logo{display:flex;align-items:center;gap:8px;font-weight:800;font-size:18px;letter-spacing:-.02em}
.topnav .logo .dot{color:var(--red)}
.topnav nav{display:flex;gap:6px;flex-wrap:wrap}
.topnav nav a{padding:8px 14px;font-size:13px;font-weight:600;color:var(--muted);border-radius:999px;transition:all .18s;cursor:pointer}
.topnav nav a:hover{color:var(--text);background:rgba(255,255,255,.04)}
.topnav nav a[data-active="true"]{color:var(--text);background:rgba(255,255,255,.08)}
.topnav .spoiler-tog{display:flex;align-items:center;gap:8px;font-size:11px;font-weight:700;color:var(--muted);letter-spacing:.06em;text-transform:uppercase}
.topnav .spoiler-tog .pill{width:32px;height:18px;border-radius:999px;background:rgba(255,255,255,.1);position:relative;transition:.18s}
.topnav .spoiler-tog .pill::after{content:'';position:absolute;top:2px;left:2px;width:14px;height:14px;border-radius:50%;background:#fff;transition:.18s}
.topnav .spoiler-tog[data-on="1"] .pill{background:var(--red)}
.topnav .spoiler-tog[data-on="1"] .pill::after{left:16px}
.topnav .spoiler-tog span:last-child{display:inline}
@media(max-width:880px){
  .topnav nav{display:none}
  .topnav .row{gap:14px}
  .topnav .spoiler-tog span:last-child{display:none}
}

@keyframes pulseRed{0%,100%{opacity:1}50%{opacity:.4}}
.live-dot{width:8px;height:8px;border-radius:50%;background:var(--red);animation:pulseRed 1.6s ease-in-out infinite;display:inline-block}

@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.fade-up{opacity:0;animation:fadeUp .55s cubic-bezier(.2,.7,.2,1) forwards}

/* Race detail hero */
.race-hero{position:relative;overflow:hidden;min-height:420px;border-radius:0}
.race-hero .bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
  filter:saturate(1.1) contrast(1.08) brightness(.55)}
.race-hero .overlay{position:absolute;inset:0;
  background:
    radial-gradient(ellipse at 25% 70%, rgba(225,6,0,.18) 0%, transparent 50%),
    linear-gradient(180deg, rgba(21,21,30,.4) 0%, rgba(21,21,30,.7) 50%, rgba(21,21,30,.98) 95%),
    linear-gradient(90deg, rgba(21,21,30,.85) 0%, rgba(21,21,30,.35) 45%, transparent 70%)}
.race-hero .content{position:relative;padding:56px 0 56px;display:flex;flex-direction:column;justify-content:flex-end;min-height:420px}
.race-hero h1{margin:8px 0 0;font-weight:800;font-size:clamp(36px,5vw,60px);line-height:1.02;letter-spacing:-.025em;max-width:880px}
.race-hero .sub{margin-top:14px;display:flex;align-items:center;gap:14px;color:var(--muted);font-size:14px;flex-wrap:wrap}
.race-hero .sub .dot{width:4px;height:4px;border-radius:50%;background:var(--muted-2)}
.race-hero .chips{display:flex;gap:8px;flex-wrap:wrap;margin-top:22px}
.race-hero .chip{padding:5px 11px;border-radius:999px;font-size:11px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;
  background:rgba(255,255,255,.08);border:1px solid var(--line-strong)}
.race-hero .chip-red{background:rgba(225,6,0,.18);border-color:rgba(225,6,0,.45);color:#ff5050}
.race-hero .chip-gold{background:rgba(255,203,5,.18);border-color:rgba(255,203,5,.45);color:#ffcb05}
.race-hero .back{display:inline-flex;align-items:center;gap:8px;color:var(--muted);font-size:13px;font-weight:600;margin-bottom:18px;cursor:pointer;transition:color .18s}
.race-hero .back:hover{color:var(--text)}
.race-hero .flag{width:48px;height:36px;border-radius:4px;overflow:hidden;display:inline-flex;align-items:center;justify-content:center;background:rgba(255,255,255,.06);font-size:24px}
.race-hero .flag img{width:100%;height:100%;object-fit:cover}
.race-hero .countdown-block{display:flex;align-items:baseline;gap:14px;color:#fff;margin-bottom:18px;flex-wrap:wrap}
.race-hero .countdown-block .num{font-weight:800;font-size:20px;letter-spacing:-.01em;font-variant-numeric:tabular-nums}
@media(max-width:720px){
  .race-hero{min-height:340px}
  .race-hero .content{min-height:340px;padding:36px 0 36px}
  .race-hero h1{font-size:clamp(28px,7.5vw,44px)}
  .race-hero .flag{width:36px;height:27px}
}

/* Section spacer */
.section{padding:36px 0}
.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:22px;flex-wrap:wrap}
.section-head h2{margin:0;font-weight:800;font-size:clamp(20px,2.4vw,28px);letter-spacing:-.02em}

/* Tabs */
.tabs{display:flex;gap:4px;background:var(--surface);border:1px solid var(--line);border-radius:999px;padding:4px;margin-bottom:24px;width:fit-content;flex-wrap:wrap}
.tabs button{padding:9px 18px;border-radius:999px;font-size:12px;font-weight:700;letter-spacing:.04em;text-transform:uppercase;color:var(--muted);transition:all .18s;white-space:nowrap}
.tabs button:hover{color:var(--text)}
.tabs button[data-on="1"]{background:var(--text);color:var(--bg)}

/* Podium 3-up cards */
.podium-3{display:grid;grid-template-columns:1fr 1.15fr 1fr;gap:14px;margin-bottom:28px;align-items:end}
@media(max-width:800px){.podium-3{grid-template-columns:1fr;align-items:stretch}}
.podium-3 .card{position:relative;overflow:hidden;border-radius:14px;cursor:default;color:#fff;
  display:flex;flex-direction:column;justify-content:flex-end;min-height:260px;padding:20px}
.podium-3 .card .photo{position:absolute;inset:0;z-index:0}
.podium-3 .card .photo img{width:100%;height:100%;object-fit:cover;object-position:top center}
.podium-3 .card .grad{position:absolute;inset:0;z-index:1}
.podium-3 .card .content{position:relative;z-index:2;display:flex;justify-content:space-between;align-items:flex-end;gap:8px}
.podium-3 .card .pos{position:absolute;top:14px;left:18px;font-weight:800;font-size:38px;line-height:1;z-index:2;text-shadow:0 2px 14px rgba(0,0,0,.5)}
.podium-3 .card .medal{position:absolute;top:14px;right:18px;font-size:22px;z-index:2}
.podium-3 .card h4{margin:0;font-size:18px;font-weight:800;letter-spacing:-.01em}
.podium-3 .card .first{font-size:12px;opacity:.85;font-weight:500;margin-bottom:2px}
.podium-3 .card .team-pill{display:inline-block;margin-top:4px;padding:3px 9px;border-radius:999px;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;background:rgba(0,0,0,.45);backdrop-filter:blur(8px);max-width:100%}
.podium-3 .card .stat{text-align:right}
.podium-3 .card .stat .num{font-size:22px;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}
.podium-3 .card .stat .l{font-size:10px;letter-spacing:.14em;text-transform:uppercase;opacity:.85;margin-top:3px}
.podium-3 .card-2{min-height:300px}

/* Results table */
.r-table{background:var(--surface-2);border-radius:14px;overflow:hidden;border:1px solid var(--line)}
.r-table .head, .r-table .row{display:grid;grid-template-columns:48px 56px 1fr 1.2fr 130px 80px;align-items:center;gap:14px;padding:13px 22px}
.r-table .head{background:rgba(255,255,255,.03);border-bottom:1px solid var(--line);
  font-size:10px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;color:var(--muted-2)}
.r-table .row{border-bottom:1px solid var(--line);transition:background .15s}
.r-table .row:last-child{border-bottom:0}
.r-table .row:hover{background:rgba(255,255,255,.025)}
.r-table .pos{font-weight:800;font-size:18px;color:var(--muted);font-variant-numeric:tabular-nums}
.r-table .row[data-top="1"] .pos{color:var(--text)}
.r-table .num-cell{font-weight:800;font-size:14px;color:var(--muted-2);font-variant-numeric:tabular-nums;letter-spacing:-.02em}
.r-table .driver{display:flex;align-items:center;gap:12px;min-width:0}
.r-table .photo{width:42px;height:42px;border-radius:50%;overflow:hidden;background:#13131a;flex-shrink:0;position:relative}
.r-table .photo img{width:100%;height:100%;object-fit:cover;object-position:top center}
.r-table .photo .stripe{position:absolute;left:0;top:0;bottom:0;width:3px;border-radius:0}
.r-table .name{font-weight:700;font-size:14px;min-width:0}
.r-table .name .first{font-weight:400;color:var(--muted);margin-right:5px}
.r-table .team{font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px}
.r-table .team .swatch{width:10px;height:10px;border-radius:2px;flex-shrink:0}
.r-table .time{text-align:right;font-size:13px;color:var(--text);font-variant-numeric:tabular-nums;font-weight:600;letter-spacing:-.01em}
.r-table .time.status{color:var(--muted);font-weight:500}
.r-table .pts{text-align:right;font-weight:800;font-size:16px;font-variant-numeric:tabular-nums}
.r-table .pts.zero{color:var(--muted-2)}
@media(max-width:880px){
  .r-table .head, .r-table .row{grid-template-columns:28px 1fr 86px 48px;gap:8px;padding:12px 12px}
  .r-table .num-cell, .r-table .team, .r-table .head .h-num, .r-table .head .h-team{display:none}
  .r-table .photo{width:34px;height:34px}
  .r-table .driver{gap:8px;overflow:hidden}
  .r-table .name{font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:flex;flex-direction:column;align-items:flex-start;line-height:1.2}
  .r-table .name .first{font-size:10px;color:var(--muted-2);margin:0}
  .r-table .time{font-size:12px}
  .r-table .pts{font-size:14px}
}
@media(max-width:380px){
  .r-table .head, .r-table .row{grid-template-columns:24px 1fr 72px 40px;gap:6px;padding:10px 8px}
  .r-table .name{font-size:12px}
  .r-table .time{font-size:11px}
}

/* Schedule (sessions) */
.sess-list{background:var(--surface-2);border-radius:14px;overflow:hidden;border:1px solid var(--line)}
.sess-list .item{display:grid;grid-template-columns:1fr auto;gap:14px;align-items:center;padding:14px 22px;border-bottom:1px solid var(--line)}
.sess-list .item:last-child{border-bottom:0}
.sess-list .item .lbl{font-weight:700;font-size:14px}
.sess-list .item .lbl .sub{font-size:11px;font-weight:600;color:var(--muted);text-transform:uppercase;letter-spacing:.1em;margin-top:2px;display:block}
.sess-list .item .when{font-size:13px;color:var(--text);font-variant-numeric:tabular-nums;text-align:right}
.sess-list .item .when .day{font-weight:700}
.sess-list .item .when .time{color:var(--muted);font-size:12px;margin-top:2px}
.sess-list .item[data-soon="1"] .lbl::before{content:'';display:inline-block;width:8px;height:8px;border-radius:50%;background:var(--red);margin-right:8px;vertical-align:middle;animation:pulseRed 1.6s ease-in-out infinite}

/* Broadcast accordion */
.brdc{display:flex;flex-direction:column;gap:8px}
.brdc .item{background:var(--surface-2);border:1px solid var(--line);border-radius:12px;overflow:hidden;transition:border-color .18s}
.brdc .item:hover{border-color:var(--line-strong)}
.brdc .item[data-empty="1"]{opacity:.55;cursor:default}
.brdc .item .head{display:grid;grid-template-columns:36px 1fr auto auto;gap:14px;align-items:center;padding:14px 18px;cursor:pointer}
.brdc .item[data-empty="1"] .head{cursor:default}
.brdc .icon{font-size:18px}
.brdc .label{font-weight:700;font-size:14px}
.brdc .sub{font-size:12px;color:var(--muted);margin-top:2px}
.brdc .live-tag{font-size:10px;font-weight:800;letter-spacing:.08em;padding:3px 8px;border-radius:999px;background:var(--red);color:#fff;animation:pulseRed 1.6s ease-in-out infinite}
.brdc .missing{font-size:11px;color:var(--muted-2);font-weight:600;letter-spacing:.06em;text-transform:uppercase}
.brdc .toggle{color:var(--muted);font-size:14px;transition:transform .2s}
.brdc .item[data-open="1"] .toggle{transform:rotate(180deg)}
.brdc .body{padding:0 18px 18px}

/* Video player */
.vplayer{position:relative;width:100%;border-radius:12px;overflow:hidden;background:#000;cursor:pointer;display:block}
.vplayer .ratio{padding-top:56.25%}
.vplayer img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;opacity:.9;transition:opacity .2s}
.vplayer:hover img{opacity:1}
.vplayer .grad{position:absolute;inset:0;background:linear-gradient(180deg, transparent 50%, rgba(0,0,0,.65))}
.vplayer .play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center}
.vplayer .play .circle{width:64px;height:64px;border-radius:50%;background:var(--red);display:flex;align-items:center;justify-content:center;
  box-shadow:0 12px 36px rgba(0,0,0,.4);transition:transform .2s}
.vplayer:hover .play .circle{transform:scale(1.08)}
.vplayer .meta{position:absolute;left:14px;bottom:12px;right:14px;display:flex;justify-content:space-between;color:#fff;gap:10px}
.vplayer .meta .prov{font-size:11px;font-weight:700;letter-spacing:.08em;text-transform:uppercase;opacity:.8}
.vplayer .meta .title{font-size:12px;font-weight:700;text-align:right;max-width:60%;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.vframe{position:relative;width:100%;border-radius:12px;overflow:hidden;background:#000}
.vframe .ratio{padding-top:56.25%}
.vframe iframe{position:absolute;inset:0;width:100%;height:100%;border:0}

/* Spoiler card */
.spoiler{position:relative;background:var(--surface-2);border:1px solid var(--line);border-radius:14px;overflow:hidden;padding:48px 24px;text-align:center;min-height:200px;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px}
.spoiler .icon{font-size:32px;margin-bottom:8px}
.spoiler .title{font-weight:800;font-size:16px}
.spoiler .sub{color:var(--muted);font-size:13px;margin-bottom:14px}

/* Loader */
.loader{display:flex;justify-content:center;padding:48px 0}
.loader .dot{width:10px;height:10px;border-radius:50%;background:var(--red);margin:0 4px;animation:bnc 1.4s ease-in-out infinite both}
.loader .dot:nth-child(2){animation-delay:.2s}
.loader .dot:nth-child(3){animation-delay:.4s}
@keyframes bnc{0%,80%,100%{transform:scale(0);opacity:.4}40%{transform:scale(1);opacity:1}}

/* Empty state */
.empty{background:var(--surface-2);border:1px solid var(--line);border-radius:14px;padding:36px 24px;text-align:center;color:var(--muted);font-size:14px}

/* Login modal */
.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.7);backdrop-filter:blur(8px);z-index:100;display:flex;align-items:center;justify-content:center;padding:24px}
.modal{background:var(--surface);border:1px solid var(--line-strong);border-radius:18px;max-width:420px;width:100%;padding:32px;position:relative}
.modal .close{position:absolute;top:14px;right:14px;width:32px;height:32px;display:flex;align-items:center;justify-content:center;color:var(--muted);border-radius:8px;font-size:18px;transition:.18s}
.modal .close:hover{color:var(--text);background:rgba(255,255,255,.06)}
.modal h2{margin:0 0 8px;font-size:22px;font-weight:800;letter-spacing:-.02em}
.modal .lead{color:var(--muted);font-size:13px;margin-bottom:20px;line-height:1.5}
.modal input{width:100%;padding:13px 16px;background:var(--surface-2);border:1px solid var(--line-strong);border-radius:10px;color:var(--text);font-size:18px;letter-spacing:.18em;text-align:center;font-weight:700;font-variant-numeric:tabular-nums;margin-bottom:12px}
.modal input:focus{outline:none;border-color:var(--red)}
.modal .err{color:#ff5050;font-size:12px;text-align:center;margin-bottom:12px;min-height:16px;font-weight:600}
.modal .or{text-align:center;color:var(--muted-2);font-size:11px;font-weight:700;letter-spacing:.16em;text-transform:uppercase;margin:18px 0;display:flex;align-items:center;gap:12px}
.modal .or::before, .modal .or::after{content:'';flex:1;height:1px;background:var(--line)}
.modal .tg-widget{display:flex;justify-content:center;min-height:48px}

::-webkit-scrollbar{width:10px;height:8px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:#2a2a35;border-radius:0}
::-webkit-scrollbar-thumb:hover{background:#3a3a48}

/* Standings page */
.standings-page{padding:36px 0 60px}
.standings-hero{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:28px;flex-wrap:wrap}
.standings-hero .lead h1{margin:6px 0 0;font-weight:800;font-size:clamp(40px,5vw,64px);letter-spacing:-.025em;line-height:1}
.standings-hero .lead .yr{color:var(--red);font-variant-numeric:tabular-nums}

/* Top-3 podium for drivers tab */
.drv-podium-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:24px}
@media(max-width:900px){.drv-podium-3{grid-template-columns:1fr}}
.drv-podium-3 .card{position:relative;overflow:hidden;border-radius:14px;min-height:280px;
  padding:22px;color:#fff;display:flex;flex-direction:column;justify-content:flex-end;cursor:default}
.drv-podium-3 .card .photo{position:absolute;inset:0;z-index:0}
.drv-podium-3 .card .photo img{width:100%;height:100%;object-fit:cover;object-position:top center}
.drv-podium-3 .card .grad{position:absolute;inset:0;z-index:1}
.drv-podium-3 .card .pos{position:absolute;top:14px;left:20px;font-weight:800;font-size:42px;line-height:1;z-index:3;text-shadow:0 2px 18px rgba(0,0,0,.7)}
.drv-podium-3 .card .medal{position:absolute;top:14px;right:18px;font-size:24px;z-index:3}
.drv-podium-3 .card .content{position:relative;z-index:2}
.drv-podium-3 .card .first{font-size:13px;opacity:.92;font-weight:500;margin-bottom:3px;text-shadow:0 2px 10px rgba(0,0,0,.7)}
.drv-podium-3 .card h4{margin:0;font-size:24px;font-weight:800;letter-spacing:-.015em;text-shadow:0 2px 14px rgba(0,0,0,.7)}
.drv-podium-3 .card .pts-row{margin-top:14px;display:flex;justify-content:space-between;align-items:flex-end;gap:8px}
.drv-podium-3 .card .pts-row .num{font-size:30px;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}
.drv-podium-3 .card .pts-row .l{font-size:10px;letter-spacing:.14em;text-transform:uppercase;opacity:.85;margin-top:3px;text-align:right}
.drv-podium-3 .card .team-pill{display:inline-block;padding:3px 9px;border-radius:999px;font-size:10px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;background:rgba(0,0,0,.45);backdrop-filter:blur(8px);max-width:100%}
.drv-podium-3 .card .bar{margin-top:12px;height:6px;border-radius:3px;background:rgba(255,255,255,.15);overflow:hidden}
.drv-podium-3 .card .bar .fill{height:100%}

/* Standings list */
.st-list{background:var(--surface-2);border-radius:14px;overflow:hidden;border:1px solid var(--line)}
.st-list .row{display:grid;grid-template-columns:54px 1fr 1.1fr 100px;align-items:center;gap:16px;padding:14px 24px;border-bottom:1px solid var(--line);transition:background .15s}
.st-list .row:last-child{border-bottom:0}
.st-list .row:hover{background:rgba(255,255,255,.025)}
.st-list .pos{font-weight:800;font-size:20px;color:var(--muted);font-variant-numeric:tabular-nums}
.st-list .driver{display:flex;align-items:center;gap:14px;min-width:0}
.st-list .stripe{width:4px;height:52px;border-radius:2px;flex-shrink:0}
.st-list .nm{min-width:0;line-height:1.2}
.st-list .nm .f{font-weight:400;color:var(--muted);font-size:13px}
.st-list .nm .l{font-weight:700;font-size:16px;display:block;letter-spacing:-.01em}
.st-list .team{font-size:13px;color:var(--muted);display:flex;align-items:center;gap:8px;min-width:0;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.st-list .team .swatch{width:10px;height:10px;border-radius:2px;flex-shrink:0}
.st-list .pts-col{text-align:right}
.st-list .pts-col .v{font-weight:800;font-size:16px;font-variant-numeric:tabular-nums}
.st-list .pts-col .gap{font-size:10px;color:var(--muted);font-variant-numeric:tabular-nums}
@media(max-width:780px){
  .st-list .row{grid-template-columns:30px 1fr 80px;gap:10px;padding:10px 14px}
  .st-list .team{display:none}
  .st-list .stripe{height:46px;width:3px}
  .st-list .nm .l{font-size:14px}
}

/* Constructors list */
.con-list{display:flex;flex-direction:column;gap:12px}
.con-card{position:relative;overflow:hidden;border-radius:14px;background:var(--surface-2);border:1px solid var(--line);border-left:4px solid var(--red);padding:18px 22px}
.con-card .row{display:grid;grid-template-columns:36px 1fr 100px;gap:16px;align-items:center}
.con-card .pos{font-weight:800;font-size:24px;color:var(--muted);font-variant-numeric:tabular-nums;text-align:center}
.con-card[data-top="1"] .pos{color:var(--text)}
.con-card .body{min-width:0}
.con-card .team-name{font-weight:800;font-size:18px;letter-spacing:-.01em;display:flex;align-items:center;gap:10px}
.con-card .logo{width:24px;height:24px;object-fit:contain;flex-shrink:0}
.con-card .drvs{display:flex;gap:10px;margin-top:12px;flex-wrap:wrap}
.con-card .drv-pill{display:flex;align-items:center;gap:10px;padding:6px 14px 6px 6px;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:999px;font-size:13px}
.con-card .drv-pill .ph{width:42px;height:42px;border-radius:50%;overflow:hidden;background:#13131a;flex-shrink:0}
.con-card .drv-pill .ph img{width:100%;height:100%;object-fit:cover;object-position:top center}
.con-card .drv-pill .lbl{display:flex;flex-direction:column;line-height:1.1;gap:2px}
.con-card .drv-pill .code{font-weight:800;font-size:14px;letter-spacing:.02em}
.con-card .drv-pill .pp{font-weight:600;font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums}
.con-card .bar{margin-top:12px;height:5px;border-radius:3px;background:rgba(255,255,255,.06);overflow:hidden;display:flex;gap:2px}
.con-card .bar .seg{height:100%}
.con-card .pts-col{text-align:right}
.con-card .pts-col .v{font-weight:800;font-size:24px;font-variant-numeric:tabular-nums;line-height:1}
.con-card .pts-col .gap{font-size:11px;color:var(--muted);font-variant-numeric:tabular-nums;margin-top:3px}
@media(max-width:680px){
  .con-card{padding:14px 16px}
  .con-card .row{grid-template-columns:28px 1fr 72px;gap:10px}
  .con-card .team-name{font-size:15px}
  .con-card .pts-col .v{font-size:18px}
}

/* H2H pair */
.h2h-grid{display:flex;flex-direction:column;gap:14px}
.h2h-card{background:var(--surface-2);border:1px solid var(--line);border-left:4px solid var(--red);border-radius:14px;overflow:hidden}
.h2h-card .head{padding:12px 22px;border-bottom:1px solid var(--line);font-weight:800;font-size:13px;letter-spacing:.06em;text-transform:uppercase}
.h2h-card .body{padding:20px 22px}
.h2h-card .pair-row{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:18px;margin-bottom:18px}
.h2h-card .who{display:flex;align-items:center;gap:12px;min-width:0}
.h2h-card .who.right{justify-content:flex-end;text-align:right}
.h2h-card .who .name{font-weight:800;font-size:16px;line-height:1.1}
.h2h-card .who .sub{font-size:12px;color:var(--muted)}
.h2h-card .who .ph{width:72px;height:72px;border-radius:50%;overflow:hidden;background:#13131a;flex-shrink:0;border:3px solid}
.h2h-card .who .ph img{width:100%;height:100%;object-fit:cover;object-position:top center}
.h2h-card .who .name{font-size:18px}
.h2h-card .pair-row{margin-bottom:24px}
.h2h-card .vs{font-size:11px;font-weight:800;letter-spacing:.14em;color:var(--muted-2);text-align:center}
.h2h-card .metric{margin-bottom:12px}
.h2h-card .metric:last-child{margin-bottom:0}
.h2h-card .metric .lbl-row{display:flex;justify-content:space-between;color:var(--muted);font-size:12px;margin-bottom:5px}
.h2h-card .metric .lbl-row .mid{font-weight:700;letter-spacing:.08em;text-transform:uppercase;font-size:10px}
.h2h-card .metric .bar{height:8px;border-radius:4px;overflow:hidden;display:flex;background:rgba(255,255,255,.05);gap:2px}
.h2h-card .metric .bar .seg{height:100%}

/* Driver cards grid */
.drv-cards{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
@media(max-width:1100px){.drv-cards{grid-template-columns:repeat(3,1fr)}}
@media(max-width:780px){.drv-cards{grid-template-columns:repeat(2,1fr)}}
@media(max-width:480px){.drv-cards{grid-template-columns:1fr}}
.drv-card{position:relative;overflow:hidden;border-radius:14px;cursor:default;background:var(--surface-2);
  border:1px solid var(--line);transition:transform .25s, border-color .18s}
.drv-card:hover{transform:translateY(-3px);border-color:var(--line-strong)}
.drv-card .photo{position:relative;aspect-ratio:0.78;overflow:hidden}
.drv-card .photo img{width:100%;height:100%;object-fit:cover;object-position:top center;transition:transform .5s}
.drv-card:hover .photo img{transform:scale(1.04)}
.drv-card .photo .num{position:absolute;top:10px;right:14px;font-weight:800;font-size:48px;line-height:1;opacity:.4;color:#fff;letter-spacing:-.02em}
.drv-card .photo .grad{position:absolute;inset:0}
.drv-card .photo .info{position:absolute;left:14px;right:14px;bottom:12px;color:#fff}
.drv-card .photo .info .first{font-size:12px;font-weight:500;opacity:.85}
.drv-card .photo .info .last{font-size:22px;font-weight:800;letter-spacing:-.015em;line-height:1.05;text-shadow:0 2px 12px rgba(0,0,0,.45)}
.drv-card .foot{display:flex;justify-content:space-between;align-items:center;padding:11px 14px;font-size:12px;font-weight:700}
.drv-card .foot .pp{padding:3px 9px;border-radius:999px;font-size:11px;font-weight:800;font-variant-numeric:tabular-nums}

/* Team cards */
.team-cards{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
@media(max-width:780px){.team-cards{grid-template-columns:1fr}}
.team-card{background:var(--surface-2);border:1px solid var(--line);border-radius:14px;overflow:hidden}
.team-card .car{position:relative;height:160px;display:flex;align-items:center;justify-content:center;padding:14px}
.team-card .car img{max-width:100%;max-height:100%;object-fit:contain}
.team-card .body{padding:16px 18px}
.team-card .body .top-row{display:flex;align-items:center;gap:12px;margin-bottom:14px}
.team-card .body .logo{width:38px;height:38px;object-fit:contain;flex-shrink:0}
.team-card .body .name{font-weight:800;font-size:18px;letter-spacing:-.01em;flex:1;min-width:0}
.team-card .body .pts-col{text-align:right}
.team-card .body .pts-col .v{font-weight:800;font-size:22px;font-variant-numeric:tabular-nums;line-height:1}
.team-card .body .pts-col .pp{font-size:10px;color:var(--muted);margin-top:3px}
.team-card .drv-row{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.team-card .drv-row .drv{display:flex;align-items:center;gap:12px;padding:10px 12px;background:rgba(255,255,255,.03);border:1px solid var(--line);border-radius:12px}
.team-card .drv-row .ph{width:52px;height:52px;border-radius:50%;overflow:hidden;background:#13131a;flex-shrink:0;border:2px solid}
.team-card .drv-row .ph img{width:100%;height:100%;object-fit:cover;object-position:top center}
.team-card .drv-row .nm{font-size:13px;line-height:1.25;min-width:0}
.team-card .drv-row .nm .c{font-weight:800;display:block;font-size:14px;letter-spacing:.02em}
.team-card .drv-row .nm .l{color:var(--muted);font-size:11px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;display:block;margin-top:2px}

/* Progress chart wrapper */
.progress-wrap{background:var(--surface-2);border:1px solid var(--line);border-radius:14px;padding:16px;height:420px}

/* Predictions page */
.predict-page{padding:36px 0 60px}
.predict-hero{margin-bottom:28px}
.predict-hero h1{margin:6px 0 4px;font-weight:800;font-size:clamp(40px,5vw,60px);letter-spacing:-.025em;line-height:1}
.predict-hero .race-sub{color:var(--muted);font-size:14px;display:flex;align-items:center;gap:10px;flex-wrap:wrap}
.predict-hero .race-sub .dot{width:4px;height:4px;border-radius:50%;background:var(--muted-2)}

/* Auth gate */
.auth-gate{background:var(--surface-2);border:1px solid var(--line);border-radius:14px;padding:64px 32px;text-align:center}
.auth-gate .ic{font-size:48px;margin-bottom:16px}
.auth-gate h2{margin:0 0 8px;font-size:22px;font-weight:800;letter-spacing:-.015em}
.auth-gate p{color:var(--muted);font-size:14px;margin:0 0 24px;line-height:1.5;max-width:380px;margin-left:auto;margin-right:auto}

/* Toast */
.toast{position:fixed;bottom:28px;left:50%;transform:translateX(-50%);padding:12px 22px;background:var(--surface);border:1px solid var(--line-strong);border-radius:999px;font-weight:700;font-size:13px;z-index:80;box-shadow:0 14px 36px rgba(0,0,0,.5);animation:fadeUp .3s ease}
.toast.ok{border-color:rgba(39,244,210,.4);color:#27F4D2}
.toast.err{border-color:rgba(225,6,0,.4);color:#ff5050}

/* Prediction card */
.pred-list{display:flex;flex-direction:column;gap:14px}
.pred-card{background:var(--surface-2);border:1px solid var(--line);border-radius:14px;padding:20px 22px;transition:border-color .18s}
.pred-card:hover{border-color:var(--line-strong)}
.pred-card .head{display:flex;align-items:center;gap:10px;margin-bottom:6px}
.pred-card .head .ic{font-size:22px}
.pred-card .head .label{font-weight:800;font-size:16px}
.pred-card .head .max{font-size:11px;color:var(--muted);margin-left:6px;font-weight:600}
.pred-card .head .done-tag{margin-left:auto;font-size:10px;font-weight:800;padding:3px 9px;border-radius:999px;background:rgba(39,244,210,.15);color:#27F4D2;letter-spacing:.08em;text-transform:uppercase}
.pred-card .desc{color:var(--muted);font-size:13px;margin-bottom:16px;line-height:1.45}
.pred-card .your-pick{padding:10px 14px;background:rgba(255,255,255,.04);border:1px solid var(--line);border-radius:10px;font-size:14px;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}
.pred-card .your-pick .lbl{color:var(--muted)}
.pred-card .your-pick .val{font-weight:700}

/* Yes/No buttons */
.yn-row{display:flex;gap:10px}
.yn-row button{flex:1;padding:14px 24px;border-radius:12px;background:var(--surface);border:1px solid var(--line);font-weight:800;font-size:14px;letter-spacing:.04em;text-transform:uppercase;transition:all .18s;cursor:pointer}
.yn-row button:hover{background:var(--red);color:#fff;border-color:var(--red);transform:translateY(-1px)}
.yn-row button:disabled{opacity:.5;cursor:not-allowed;transform:none}

/* Number row */
.num-row{display:flex;gap:8px;flex-wrap:wrap}
.num-row button{width:52px;height:52px;border-radius:12px;background:var(--surface);border:1px solid var(--line);font-weight:800;font-size:18px;font-variant-numeric:tabular-nums;transition:all .18s;cursor:pointer}
.num-row button:hover{background:var(--red);color:#fff;border-color:var(--red);transform:translateY(-1px)}
.num-row button:disabled{opacity:.5;cursor:not-allowed;transform:none}

/* Driver picker grid */
.drv-pick{display:grid;grid-template-columns:repeat(10,1fr);gap:8px}
@media(max-width:1000px){.drv-pick{grid-template-columns:repeat(6,1fr)}}
@media(max-width:600px){.drv-pick{grid-template-columns:repeat(4,1fr)}}
.drv-pick button{position:relative;padding:9px 6px;border-radius:12px;background:var(--surface);border:1px solid var(--line);display:flex;flex-direction:column;align-items:center;gap:5px;cursor:pointer;transition:all .18s}
.drv-pick button:hover{background:var(--surface-3);transform:translateY(-2px);border-color:var(--line-strong)}
.drv-pick button:disabled{opacity:.5;cursor:not-allowed;transform:none}
.drv-pick button[data-sel="1"]{background:rgba(225,6,0,.15);border-color:var(--red)}
.drv-pick button .stripe{width:24px;height:3px;border-radius:2px}
.drv-pick button .ph{width:48px;height:48px;border-radius:50%;overflow:hidden;background:#13131a}
.drv-pick button .ph img{width:100%;height:100%;object-fit:cover;object-position:top center}
.drv-pick button .code{font-size:11px;font-weight:800;letter-spacing:.04em;color:var(--muted)}
.drv-pick button[data-sel="1"] .code{color:var(--text)}
.drv-pick button .idx{position:absolute;top:-5px;right:-5px;width:22px;height:22px;border-radius:50%;background:var(--red);color:#fff;font-size:11px;font-weight:800;display:flex;align-items:center;justify-content:center;box-shadow:0 2px 8px rgba(225,6,0,.5)}

/* Podium confirm */
.podium-confirm{display:flex;align-items:center;justify-content:space-between;gap:14px;margin-top:18px;flex-wrap:wrap}
.podium-confirm .info{color:var(--muted);font-size:13px}
.podium-confirm .info b{color:var(--text);font-weight:800}

/* History */
.hist-section{margin-top:48px}
.hist-list{display:flex;flex-direction:column;gap:14px}
.hist-card{background:var(--surface-2);border:1px solid var(--line);border-radius:14px;overflow:hidden}
.hist-card .head{display:flex;align-items:center;gap:14px;padding:14px 20px;background:rgba(255,255,255,.03);border-bottom:1px solid var(--line)}
.hist-card .head .r-tag{width:38px;height:38px;border-radius:10px;background:rgba(225,6,0,.18);color:var(--red);display:flex;align-items:center;justify-content:center;font-weight:800;font-size:13px;flex-shrink:0}
.hist-card .head .title{flex:1;min-width:0}
.hist-card .head .title .nm{font-weight:800;font-size:14px;letter-spacing:-.005em}
.hist-card .head .title .sub{color:var(--muted);font-size:11px;margin-top:2px}
.hist-card .head .total{text-align:right}
.hist-card .head .total .num{font-weight:800;font-size:20px;font-variant-numeric:tabular-nums;line-height:1}
.hist-card .head .total .lbl{color:var(--muted);font-size:10px;text-transform:uppercase;letter-spacing:.1em;margin-top:3px}
.hist-card .item{display:grid;grid-template-columns:24px 1fr 60px;align-items:center;gap:12px;padding:10px 20px;border-bottom:1px solid var(--line)}
.hist-card .item:last-child{border-bottom:0}
.hist-card .item .ic{font-size:17px;text-align:center}
.hist-card .item .descr{display:flex;align-items:baseline;gap:10px;min-width:0}
.hist-card .item .descr .ptype{color:var(--muted);font-size:11px;text-transform:uppercase;letter-spacing:.08em;width:108px;flex-shrink:0}
.hist-card .item .descr .val{font-weight:700;font-size:13px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.hist-card .item .pts{text-align:right;font-weight:800;font-size:14px;font-variant-numeric:tabular-nums}
@media(max-width:640px){
  .hist-card .item{grid-template-columns:20px 1fr 50px;gap:8px;padding:10px 14px}
  .hist-card .item .descr .ptype{display:none}
  .hist-card .head{padding:12px 14px}
}

/* Stub for pages not yet migrated */
.stub{padding:120px 0;text-align:center}
.stub .kk{font-size:11px;font-weight:700;letter-spacing:.2em;color:var(--muted);text-transform:uppercase;margin-bottom:14px}
.stub h1{font-size:clamp(48px,7vw,96px);font-weight:800;letter-spacing:-.03em;margin:0 0 24px;line-height:1}
.stub p{color:var(--muted);font-size:16px;max-width:480px;margin:0 auto;line-height:1.6}
.stub .ghost-link{display:inline-flex;margin-top:24px;padding:12px 22px;border-radius:999px;background:rgba(255,255,255,.06);border:1px solid var(--line-strong);font-weight:700;font-size:13px;transition:.18s;cursor:pointer}
.stub .ghost-link:hover{background:rgba(255,255,255,.1)}
