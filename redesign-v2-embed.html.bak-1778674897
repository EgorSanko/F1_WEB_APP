<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8" />
<title>F1 HUB</title>
<meta name="viewport" content="width=device-width,initial-scale=1" />
<link rel="stylesheet" href="/static/fonts/manrope.css">
<style>
:root{
  --bg:#15151E;            /* dark navy base, not pure black */
  --surface:#1c1c28;       /* surface 1 */
  --surface-2:#262633;     /* surface 2 — cards */
  --surface-3:#2f2f3e;     /* hover */
  --line:rgba(255,255,255,.06);
  --line-strong:rgba(255,255,255,.12);
  --text:#fafafa;
  --muted:#a0a0b0;
  --muted-2:#6b6b7b;
  --red:#E10600;
  --red-hover:#FF1A0D;
  --gold:#FFCB05;
  --silver:#C0C0C0;
  --bronze:#CD7F32;
}
*{box-sizing:border-box}
html,body{margin:0;padding:0;color:var(--text);
  font-family:'Manrope',ui-sans-serif,system-ui,sans-serif;
  font-weight:400;-webkit-font-smoothing:antialiased;letter-spacing:-.005em}
body{overflow-x:hidden;
  background:
    radial-gradient(ellipse 1200px 800px at 20% 0%, rgba(225,6,0,.06) 0%, transparent 50%),
    radial-gradient(ellipse 1000px 600px at 100% 50%, rgba(80,80,200,.04) 0%, transparent 50%),
    radial-gradient(ellipse 800px 600px at 0% 100%, rgba(225,6,0,.04) 0%, transparent 50%),
    var(--bg);
  background-attachment:fixed}
img{display:block;max-width:100%}
a{color:inherit;text-decoration:none}
button{font-family:inherit;cursor:pointer;border:0;background:none;color:inherit}

/* Container */
.cnt{max-width:1280px;margin:0 auto;padding:0 24px}
@media(max-width:720px){.cnt{padding:0 16px}}

/* Headings — all Manrope, just weight + size */
.h-display{font-weight:800;letter-spacing:-.025em;line-height:1.02}
.h-section{font-weight:800;font-size:14px;letter-spacing:.05em;text-transform:uppercase;color:var(--muted)}
.eyebrow{font-size:11px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--muted)}
.eyebrow-red{color:var(--red)}

/* Buttons */
.btn{display:inline-flex;align-items:center;gap:8px;padding:11px 22px;font-weight:700;font-size:13px;
  border-radius:999px;transition:all .18s ease;letter-spacing:-.005em}
.btn-red{background:var(--red);color:#fff}
.btn-red:hover{background:var(--red-hover);transform:translateY(-1px)}
.btn-ghost{background:rgba(255,255,255,.06);color:var(--text);border:1px solid var(--line-strong)}
.btn-ghost:hover{background:rgba(255,255,255,.1)}
.btn-link{padding:6px 0;font-size:13px;font-weight:700;color:var(--text);display:inline-flex;gap:8px;align-items:center}
.btn-link::after{content:'→';transition:transform .18s}
.btn-link:hover::after{transform:translateX(3px)}

/* Top nav */
.topnav{position:sticky;top:0;z-index:50;background:rgba(21,21,30,.85);backdrop-filter:blur(20px) saturate(140%);
  -webkit-backdrop-filter:blur(20px) saturate(140%);border-bottom:1px solid var(--line);padding:14px 0}
.topnav .row{display:flex;align-items:center;gap:32px}
.topnav .logo{display:flex;align-items:center;gap:8px;font-weight:800;font-size:18px;letter-spacing:-.02em}
.topnav .logo .dot{color:var(--red)}
.topnav nav{display:flex;gap:6px;flex-wrap:wrap}
.topnav nav a{padding:8px 14px;font-size:13px;font-weight:600;color:var(--muted);border-radius:999px;transition:all .18s}
.topnav nav a:hover{color:var(--text);background:rgba(255,255,255,.04)}
.topnav nav a[data-active="true"]{color:var(--text);background:rgba(255,255,255,.08)}

/* Live indicator */
@keyframes pulseRed{0%,100%{opacity:1}50%{opacity:.4}}
.live-dot{width:8px;height:8px;border-radius:50%;background:var(--red);animation:pulseRed 1.6s ease-in-out infinite;display:inline-block}

/* Fade up */
@keyframes fadeUp{from{opacity:0;transform:translateY(14px)}to{opacity:1;transform:translateY(0)}}
.fade-up{opacity:0;animation:fadeUp .55s cubic-bezier(.2,.7,.2,1) forwards}

/* Hero */
.hero{position:relative;overflow:hidden;min-height:620px;border-radius:0}
.hero .bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
  filter:saturate(1.1) contrast(1.08) brightness(.7)}
.hero .overlay{position:absolute;inset:0;
  background:
    radial-gradient(ellipse at 30% 60%, rgba(225,6,0,.18) 0%, transparent 50%),
    linear-gradient(180deg, rgba(21,21,30,.35) 0%, rgba(21,21,30,.65) 50%, rgba(21,21,30,.98) 95%),
    linear-gradient(90deg, rgba(21,21,30,.85) 0%, rgba(21,21,30,.35) 45%, transparent 70%)}
.hero .content{position:relative;padding:80px 0 80px;display:flex;flex-direction:column;justify-content:flex-end;min-height:620px}
.hero h1{margin:0;font-weight:800;font-size:clamp(36px,5.5vw,68px);line-height:1.02;letter-spacing:-.028em;max-width:780px}
.hero .meta{display:flex;align-items:center;gap:14px;margin-bottom:20px;flex-wrap:wrap}
.hero .ctas{margin-top:28px;display:flex;gap:10px;flex-wrap:wrap}

/* Sponsor banner strip (bottom of hero) */
.sponsor-strip{position:absolute;left:0;right:0;bottom:0;height:42px;z-index:2;
  background:linear-gradient(90deg, var(--red) 0%, #b00500 50%, var(--red) 100%);
  display:flex;align-items:center;overflow:hidden;border-top:1px solid rgba(255,255,255,.18);
  border-bottom:1px solid rgba(0,0,0,.3)}
.sponsor-strip .scroll-track{display:flex;gap:48px;white-space:nowrap;
  animation:scrollX 40s linear infinite;will-change:transform;padding-left:0}
@keyframes scrollX{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.sponsor-strip .item{font-weight:800;font-size:12px;letter-spacing:.28em;color:#fff;
  text-transform:uppercase;display:flex;align-items:center;gap:48px}
.sponsor-strip .item::after{content:'●';color:rgba(255,255,255,.6);font-size:8px;margin-left:48px}

/* Ticker strip between sections */
.ticker{background:linear-gradient(90deg, transparent, rgba(255,255,255,.025) 50%, transparent);
  border-top:1px solid var(--line);border-bottom:1px solid var(--line);
  overflow:hidden;padding:14px 0}
.ticker .track{display:flex;gap:48px;white-space:nowrap;animation:scrollX 60s linear infinite;
  font-weight:700;font-size:12px;letter-spacing:.22em;text-transform:uppercase;color:var(--muted)}
.ticker .track .red{color:var(--red)}

/* Section dark + alternate atmosphere */
.atmos-track{position:relative}
.atmos-track::before{content:'';position:absolute;left:0;right:0;top:0;height:1px;
  background:linear-gradient(90deg, transparent, var(--red), transparent);opacity:.4;pointer-events:none}

/* News grid */
.news-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:18px}
@media(max-width:1000px){.news-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.news-grid{grid-template-columns:1fr}}
.news-card{background:var(--surface-2);border-radius:12px;overflow:hidden;cursor:pointer;
  transition:transform .22s ease, background .22s ease;display:flex;flex-direction:column}
.news-card:hover{transform:translateY(-3px);background:var(--surface-3)}
.news-card .thumb{position:relative;aspect-ratio:16/10;overflow:hidden;background:#13131a}
.news-card .thumb img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.news-card:hover .thumb img{transform:scale(1.04)}
.news-card .play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  background:rgba(0,0,0,.2)}
.news-card .play svg{width:48px;height:48px;opacity:.85}
.news-card .body{padding:14px 16px 18px}
.news-card .body h3{margin:0 0 8px;font-weight:700;font-size:15px;line-height:1.3;color:var(--text)}
.news-card .body .kicker{font-size:11px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--muted-2)}

/* Quick-link buttons row (4) */
.quick-row{display:grid;grid-template-columns:repeat(4,1fr);gap:14px}
@media(max-width:900px){.quick-row{grid-template-columns:repeat(2,1fr)}}
.quick-row a{padding:16px 18px;background:var(--surface);border:1px solid var(--line);border-radius:10px;
  display:flex;align-items:center;justify-content:space-between;font-weight:700;font-size:13px;
  letter-spacing:.04em;text-transform:uppercase;transition:all .18s}
.quick-row a:hover{background:var(--surface-2);border-color:var(--line-strong)}
.quick-row a::after{content:'→';color:var(--muted)}

/* Editor's pick */
.editor-grid{display:grid;grid-template-columns:1.6fr 1fr;gap:18px}
@media(max-width:900px){.editor-grid{grid-template-columns:1fr}}
.editor-feature{position:relative;overflow:hidden;aspect-ratio:16/10;border-radius:12px;cursor:pointer}
.editor-feature img{width:100%;height:100%;object-fit:cover;transition:transform .6s}
.editor-feature:hover img{transform:scale(1.03)}
.editor-feature .ov{position:absolute;inset:0;
  background:linear-gradient(180deg, transparent 40%, rgba(0,0,0,.85))}
.editor-feature .txt{position:absolute;bottom:0;left:0;right:0;padding:24px}
.editor-feature h3{margin:0;font-weight:800;font-size:24px;line-height:1.15;letter-spacing:-.015em}
.editor-list{display:flex;flex-direction:column;gap:14px}
.editor-list .it{display:grid;grid-template-columns:140px 1fr;gap:14px;background:var(--surface-2);border-radius:10px;overflow:hidden;cursor:pointer;transition:background .22s}
.editor-list .it:hover{background:var(--surface-3)}
.editor-list .it img{width:140px;height:100%;object-fit:cover;aspect-ratio:1}
.editor-list .it .body{padding:12px 14px 12px 0}
.editor-list .it h4{margin:0 0 6px;font-size:14px;font-weight:700;line-height:1.3}
.editor-list .it .kk{font-size:10px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--muted-2)}

/* Team tabs */
.team-tabs{display:flex;gap:6px;margin-bottom:24px;overflow-x:auto;padding-bottom:4px}
.team-tabs button{flex-shrink:0;padding:9px 16px;background:var(--surface);border:1px solid var(--line);
  border-radius:999px;font-size:12px;font-weight:700;color:var(--muted);transition:all .18s;display:flex;align-items:center;gap:8px}
.team-tabs button:hover{color:var(--text);border-color:var(--line-strong)}
.team-tabs button[data-on="1"]{background:var(--text);color:var(--bg);border-color:var(--text)}
.team-tabs button .swatch{width:8px;height:8px;border-radius:50%}

/* Driver pair (within selected team) */
.driver-pair{display:grid;grid-template-columns:repeat(2,1fr);gap:16px}
@media(max-width:700px){.driver-pair{grid-template-columns:1fr}}
.driver-pair .card{position:relative;overflow:hidden;border-radius:14px;aspect-ratio:1.1;cursor:pointer;
  transition:transform .25s}
.driver-pair .card:hover{transform:translateY(-3px)}
.driver-pair .card .photo{position:absolute;inset:0}
.driver-pair .card .photo img{width:100%;height:100%;object-fit:cover;object-position:top center}
.driver-pair .card .grad{position:absolute;inset:0}
.driver-pair .card .info{position:absolute;bottom:0;left:0;right:0;padding:18px;display:flex;justify-content:space-between;align-items:flex-end;color:#fff}
.driver-pair .card .info h4{margin:0;font-weight:800;font-size:22px;line-height:1.05;letter-spacing:-.015em}
.driver-pair .card .info .first{font-size:13px;opacity:.8;font-weight:500;margin-bottom:2px}
.driver-pair .card .info .pts{text-align:right;font-weight:800}
.driver-pair .card .info .pts .num{font-size:24px;line-height:1}
.driver-pair .card .info .pts .l{font-size:10px;letter-spacing:.14em;text-transform:uppercase;opacity:.8;margin-top:2px}
.driver-pair .card .no{position:absolute;top:12px;right:14px;font-weight:800;font-size:48px;opacity:.6;color:#fff;line-height:1}

/* Podium 3 cards */
.podium-3{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:32px}
@media(max-width:800px){.podium-3{grid-template-columns:1fr}}
.podium-3 .card{position:relative;overflow:hidden;border-radius:14px;aspect-ratio:1.45;cursor:pointer;color:#fff}
.podium-3 .card .photo{position:absolute;inset:0}
.podium-3 .card .photo img{width:100%;height:100%;object-fit:cover;object-position:top center}
.podium-3 .card .grad{position:absolute;inset:0}
.podium-3 .card .info{position:absolute;bottom:0;left:0;right:0;padding:18px;display:flex;justify-content:space-between;align-items:flex-end}
.podium-3 .card .pos{position:absolute;top:14px;left:18px;font-weight:800;font-size:36px;line-height:1}
.podium-3 .card .info h4{margin:0;font-size:18px;font-weight:800;letter-spacing:-.015em}
.podium-3 .card .info .first{font-size:12px;opacity:.85;font-weight:500}
.podium-3 .card .info .pts{text-align:right}
.podium-3 .card .info .pts .num{font-size:22px;font-weight:800}
.podium-3 .card .info .pts .l{font-size:10px;letter-spacing:.14em;text-transform:uppercase;opacity:.85;margin-top:2px}

/* Standings table */
.standings-table{background:var(--surface-2);border-radius:12px;overflow:hidden}
.standings-table .head, .standings-table .row{display:grid;grid-template-columns:54px 1fr 54px 1.2fr 80px;align-items:center;gap:18px;padding:14px 22px}
.standings-table .head{background:rgba(255,255,255,.03);border-bottom:1px solid var(--line);
  font-size:10px;font-weight:700;letter-spacing:.18em;text-transform:uppercase;color:var(--muted-2)}
.standings-table .row{border-bottom:1px solid var(--line);transition:background .15s}
.standings-table .row:last-child{border-bottom:0}
.standings-table .row:hover{background:rgba(255,255,255,.025)}
.standings-table .pos{font-weight:800;font-size:18px;color:var(--muted)}
.standings-table .driver{display:flex;align-items:center;gap:12px}
.standings-table .photo{width:42px;height:42px;border-radius:50%;overflow:hidden;background:#13131a;flex-shrink:0}
.standings-table .photo img{width:100%;height:100%;object-fit:cover;object-position:top center}
.standings-table .name{font-weight:700;font-size:15px}
.standings-table .name .first{font-weight:400;color:var(--muted);margin-right:5px}
.standings-table .teamlogo{width:36px;height:36px;display:flex;align-items:center;justify-content:center;
  background:rgba(255,255,255,.04);border-radius:8px;font-size:10px;font-weight:800}
.standings-table .team{font-size:13px;color:var(--muted)}
.standings-table .pts{text-align:right;font-weight:800;font-size:18px}
@media(max-width:720px){
  .standings-table .head, .standings-table .row{grid-template-columns:32px 1fr 60px;gap:10px;padding:12px 14px}
  .standings-table .teamlogo, .standings-table .team, .standings-table .head .h-team, .standings-table .head .h-tl{display:none}
}

/* Highlights videos */
.video-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:16px}
@media(max-width:1000px){.video-grid{grid-template-columns:repeat(2,1fr)}}
@media(max-width:600px){.video-grid{grid-template-columns:1fr}}
.video-card{position:relative;border-radius:10px;overflow:hidden;cursor:pointer;background:var(--surface-2)}
.video-card .thumb{position:relative;aspect-ratio:16/10;overflow:hidden}
.video-card .thumb img{width:100%;height:100%;object-fit:cover;transition:transform .5s}
.video-card:hover .thumb img{transform:scale(1.04)}
.video-card .play{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;
  background:linear-gradient(180deg, transparent 50%, rgba(0,0,0,.65))}
.video-card .play svg{width:46px;height:46px;opacity:.92}
.video-card .body{padding:12px 14px 14px}
.video-card .body h4{margin:0;font-size:13px;font-weight:700;line-height:1.3}

/* Footer CTA - night track motion blur */
.foot-cta{position:relative;overflow:hidden;border-radius:14px;min-height:340px;
  background:
    radial-gradient(ellipse at 80% 50%, rgba(255,180,50,.18) 0%, transparent 60%),
    radial-gradient(ellipse at 20% 70%, rgba(225,6,0,.15) 0%, transparent 55%),
    linear-gradient(180deg, #0a0a14 0%, #1a1525 60%, #0d0a18 100%)}
.foot-cta .bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;
  filter:brightness(.55) saturate(1.2) contrast(1.1);opacity:.85}
.foot-cta .ov{position:absolute;inset:0;
  background:linear-gradient(90deg, rgba(10,10,20,.92) 0%, rgba(10,10,20,.4) 60%, transparent 100%)}
/* Motion light streaks */
.foot-cta .streaks{position:absolute;inset:0;pointer-events:none;
  background:repeating-linear-gradient(85deg, transparent 0, transparent 30px,
    rgba(255,200,80,.12) 30px, rgba(255,200,80,.12) 32px,
    transparent 32px, transparent 80px,
    rgba(225,6,0,.1) 80px, rgba(225,6,0,.1) 82px);
  mix-blend-mode:screen;opacity:.6;filter:blur(.6px)}
.foot-cta .content{position:relative;padding:48px 40px;display:flex;justify-content:space-between;align-items:center;gap:24px;flex-wrap:wrap;min-height:340px;z-index:2}
.foot-cta h2{margin:0;font-weight:800;font-size:clamp(28px,3.5vw,44px);line-height:1.05;letter-spacing:-.02em;max-width:560px;color:#fff;text-shadow:0 2px 20px rgba(0,0,0,.6)}
.foot-cta .right{display:flex;flex-direction:column;gap:14px;align-items:flex-start}

/* Section spacer */
.section{padding:48px 0}
.section-head{display:flex;align-items:flex-end;justify-content:space-between;gap:18px;margin-bottom:24px;flex-wrap:wrap}
.section-head h2{margin:0;font-weight:800;font-size:clamp(22px,2.6vw,32px);letter-spacing:-.02em}

/* Skeleton */
.sk{background:linear-gradient(90deg, var(--surface) 25%, var(--surface-2) 50%, var(--surface) 75%);
  background-size:200% 100%;animation:sk 1.4s infinite}
@keyframes sk{0%{background-position:200% 0}100%{background-position:-200% 0}}

::-webkit-scrollbar{width:10px;height:8px}
::-webkit-scrollbar-track{background:transparent}
::-webkit-scrollbar-thumb{background:#2a2a35;border-radius:0}
::-webkit-scrollbar-thumb:hover{background:#3a3a48}
</style>
