// ============ APP ============
function App() {
  const [home, setHome] = useState(null);
  const [standings, setStandings] = useState(null);
  const [schedule, setSchedule] = useState(null);
  const [news, setNews] = useState(null);
  const [broadcasts, setBroadcasts] = useState(null);

  useEffect(() => {
    Promise.all([
      apiGet('/api/home?season=2026'),
      apiGet('/api/standings/drivers?season=2026'),
      apiGet('/api/schedule?season=2026'),
      apiGet('/api/news'),
      apiGet('/api/broadcasts?season=2026'),
    ]).then(([h, st, sc, n, b]) => {
      setHome(h);
      setStandings(st?.standings || []);
      setSchedule(sc?.races || []);
      const newsList = n?.posts || n?.articles || (Array.isArray(n) ? n : []) || [];
      const f1Keywords = /формул|f1|гонщ|болид|гран-при|гран при|трас|пилот|чемпион|квалиф|подиум|сезон|спринт|маклар|феррар|мерседес|ред булл|астон|вильямс|альпин|сауб|хаас/i;
      const filtered = newsList.filter(p => f1Keywords.test(p.title || '') || f1Keywords.test(p.preview || ''));
      setNews(filtered.length ? filtered : newsList);
      setBroadcasts(b?.broadcasts || []);
    });
  }, []);

  const scheduleByRound = useMemo(() => {
    const m = {};
    (schedule || []).forEach(r => { m[r.round] = r; });
    return m;
  }, [schedule]);

  return (
    <Fragment>
      
      <Hero nextRace={home?.next_race} lastRace={home?.last_race} scheduleByRound={scheduleByRound}/>
      <Highlights broadcasts={broadcasts} scheduleByRound={scheduleByRound}/>
      <NewsGrid news={news}/>
      <QuickLinks/>
      <Ticker/>
      <EditorsPicks lastRace={home?.last_race} news={news}/>
      <DriversByTeam standings={standings}/>
      <PodiumTop3 standings={standings}/>
      <StandingsTable standings={standings}/>
      <Ticker/>
      <FooterCTA/>
      <footer style={{ padding:'32px 0', borderTop:'1px solid var(--line)', color:'var(--muted)' }}>
        <div className="cnt" style={{ display:'flex', justifyContent:'space-between', flexWrap:'wrap', gap:14, fontSize:12 }}>
          <span>F1·HUB · trackside edition · 2026</span>
          <span>Фанатский ресурс · данные из открытых источников</span>
        </div>
      </footer>
    </Fragment>
  );
}

ReactDOM.createRoot(document.getElementById('root')).render(<App />);
</script>

<script>
(function(){
  function send(){ try { parent.postMessage({type:"f1hub-prem-height", h: document.documentElement.scrollHeight}, "*"); } catch(e){} }
  window.addEventListener("load", () => { setTimeout(send, 100); setTimeout(send, 600); setTimeout(send, 1500); });
  const ro = new ResizeObserver(send); ro.observe(document.documentElement);
  setInterval(send, 2000);
  // intercept internal links -> tell parent to navigate
  document.addEventListener("click", e => {
    const a = e.target.closest("a[href^=\"/\"], a[href^=\"./\"]");
    if (a && a.href && !a.target) {
      e.preventDefault();
      parent.postMessage({type:"f1hub-prem-nav", href: new URL(a.href).pathname}, "*");
    }
  });
})();
</script>
